<?xml version="1.0" encoding="utf-8"?>
<!--
    فونت پیش‌فرض برنامه.
    فایل‌های .ttf زیر را از مخزن رسمی Vazirmatn (SIL OFL 1.1) دانلود کن و
    داخل همین پوشه (res/font) با همین نام قرار بده:
    vazirmatn_regular.ttf, vazirmatn_medium.ttf, vazirmatn_bold.ttf
    منبع: https://github.com/rastikerdar/vazirmatn
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/vazirmatn_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/vazirmatn_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/vazirmatn_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
